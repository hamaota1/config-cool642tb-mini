#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define FUNCTION 1
#define NUM 2
#define ARROW 3
#define MOUSE 4
#define SCROLL 5
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        shift_tab {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        lang {
            bindings = <&kp CAPS>;
            key-positions = <18 19>;
        };

        Escape {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
        };

        PrevTab {
            bindings = <&kp LS(LC(TAB))>;
            key-positions = <5 6>;
        };

        FwdTab {
            bindings = <&kp LC(TAB)>;
            key-positions = <6 7>;
        };

        Expand {
            bindings = <&kp LG(LS(EQUAL))>;
            key-positions = <8 9>;
        };

        Shrink {
            bindings = <&kp LG(MINUS)>;
            key-positions = <7 8>;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W             &kp E         &kp R         &kp T                                        &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A           &kp S             &kp D         &kp F         &kp G        &kp LC(Y)         &lt 7 CLCK    &kp H          &kp J  &lt 5 K    &kp L    &kp SEMICOLON
&kp Z           &kp X             &kp C         &kp V         &kp B        &lt 3 ESCAPE      &kp TAB       &kp N          &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 1 SPACE  &lt 2 CAPS        &lt 2 RETURN  &kp BACKSPACE                             &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        FUNCTION {
            bindings = <
&kp F1        &kp F2            &kp F3             &kp F4                &kp F5                                             &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
&kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3       &kp NUMBER_4          &kp NUMBER_5  &kp UNDER      &kp LS(LG(NUMBER_3))  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp GRAVE     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &kp MINUS     &trans         &trans                &kp EQUAL     &kp SQT       &kp F8        &kp F11       &kp F12
&trans        &trans            &trans             &trans                &trans        &trans         &trans                &trans                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        NUM {
            bindings = <
&kp LA(LC(E))  &kp LA(LC(R))  &kp LA(LC(T))  &kp LA(LC(U))  &kp LC(LA(I))                          &kp LC(LEFT_ARROW)    &kp LEFT_ARROW      &kp UP_ARROW  &kp RIGHT_ARROW   &kp LC(RIGHT_ARROW)
&kp LA(LC(D))  &kp LA(LC(F))  &kp LA(LC(G))  &kp LA(LC(J))  &kp LA(LC(K))  &kp LS(LT)      &trans  &kp C_BRIGHTNESS_INC  &kp LC(DOWN_ARROW)  &kp DOWN      &kp LC(UP_ARROW)  &kp C_VOLUME_UP
&trans         &trans         &trans         &trans         &trans         &trans          &trans  &kp C_BRIGHTNESS_DEC  &kp LG(LC(F))       &kp LG(TAB)   &kp K_MUTE        &kp C_VOL_DN
&trans         &trans         &trans         &trans         &trans         &trans          &trans  &trans                                                                    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans                          &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTRK
&kp TAB     &trans  &trans  &trans  &trans  &trans      &trans      &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH
&trans      &trans  &trans  &trans  &trans  &trans      &kp PERIOD  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&trans      &trans  &trans  &trans  &trans  &trans      &trans      &trans                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BLE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bt BT_CLR  &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
